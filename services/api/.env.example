PORT=8080
DATABASE_URL=host=localhost user=hpcl_app password=change-me dbname=jpganeriwala_hpcl port=5432 sslmode=disable
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=168h
APP_ENV=development

# Required — server refuses to start without it (see cmd/server/main.go).
# Generate with: openssl rand -hex 32
OTP_PEPPER=replace-with-a-long-random-string

# Optional — email OTP delivery falls back to logging instead of sending
# when these are unset (see internal/notify), so local dev works without a
# real Gmail account. To enable real sending:
#   1. Turn on 2-Step Verification on the sending Gmail account.
#   2. Generate an App Password: Google Account -> Security -> 2-Step
#      Verification -> App passwords. Use that here, NOT the account's
#      real login password (Gmail rejects the real password for SMTP auth
#      from a script).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=M/s Jay Prakash Ganeriwala

# Optional — Google Sign-In returns "Google sign-in is not available right
# now" when unset (see handlers.GoogleAuthHandler), so local dev works
# without it. To enable:
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create
#      Credentials -> OAuth client ID -> Application type: Web application.
#   2. Authorized JavaScript origins: add your frontend URL (e.g.
#      http://localhost:5173, and your real domain in production).
#   3. Copy the generated Client ID here. No client secret is needed — this
#      flow only verifies a signed ID token, it never exchanges a code.
#   4. Set the SAME value as VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=
